 * 
 * Charybdis right keyboard - Standalone mode (acts as central)
 * Processes trackball input locally
 */

#include "charybdis_right_common.dtsi"
#include "charybdis_trackball_processors.dtsi"

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball>;

        CHARYBDIS_TRACKBALL_PROCESSORS
    };
};

/* TEMP DEBUG: USB CDC ACM console so ZMK USB logging builds under Zephyr 4.1. Revert after. */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
};
