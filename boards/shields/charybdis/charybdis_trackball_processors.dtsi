 * SPDX-License-Identifier: MIT
 * 
 * Common trackball input processor configurations for Charybdis keyboard
 * This file defines the standard processing for snipe, scroll, and move modes
 * 
 * Usage: Include this file and define CHARYBDIS_TRACKBALL_LISTENER macro
 * Example:
 *   #define CHARYBDIS_TRACKBALL_LISTENER snipe { layers = <SNIPING>; input-processors = <&zip_xy_scaler 1 3>; }; scroll { layers = <SCROLL>; input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_scaler 1 20>, <&zip_xy_to_scroll_mapper>; }; move { layers = <BASE POINTER>; input-processors = <&zip_xy_scaler 7 6>; };
 */

#include "charybdis_layers.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

// Single global instance (the driver uses DEVICE_DT_INST_GET(0)), so these apply to
// every &zip_temp_layer reference below.
&zip_temp_layer {
    // Brushing the ball mid-typing must NOT raise the mouse layer. The thumb rests
    // right next to it on a Charybdis, so this is the property that makes the whole
    // thing usable: should_quick_tap() suppresses activation for this long after any
    // keystroke.
    require-prior-idle-ms = <300>;

    // Counter-intuitive semantics, straight from input_processor_temp_layer.c: with an
    // EMPTY list nothing ever deactivates the layer early, it only times out. Once the
    // list is non-empty, any position NOT in it deactivates immediately. So this is the
    // set of keys usable without dropping the layer -- i.e. exactly what AUTO_MOUSE binds.
    // Keep this in step with every non-transparent binding on AUTO_MOUSE, including
    // ones added later from a keymap editor: a position bound on that layer but missing
    // here is dead on arrival, because the layer drops before the binding resolves.
    //   15 F=snipe  16 P=MB4  17 B=MB5  25 A=scroll  26 R=scroll  27 S=RCLK
    //   28 T=LCLK   29 G=MCLK 39 C=scroll 41 V=scroll 44 ,=LCLK   45 .=RCLK
    excluded-positions = <15 16 17 25 26 27 28 29 39 41 44 45>;
};

// Standard trackball processing configuration
// Can be used in both standalone (trackball_listener) and dongle mode (input_split_listener)
//
// Every divisor here is relative to `cpi` in charybdis_right_common.dtsi (1600).
// Effective resolution = cpi * mul / div:
//   move  1600 * 3/4  = 1200    snipe 1600 * 1/6 = 267    scroll 1600 * 1/160 = 10
// move/snipe hold the 4.5x ratio the original cpi=400 setup had, at twice its speed --
// 600 effective was ~5 thumb sweeps to cross a screen. cpi stays high because it buys
// resolution, not speed: the divisors here set the speed, and dividing is lossless
// (input_processor_scaler.c accumulates the remainder) while multiplying is not.
// Scroll is left alone: how fast a page scrolls is its own preference, unrelated to
// pointer speed. If you change cpi, rescale all three or the feel shifts everywhere.
// &zip_temp_layer AUTO_MOUSE 500 is repeated in all three chains on purpose.
// input_listener.c walks these children in declaration order and stops at the first
// whose layer_mask is active (`if (!override->process_next) return 0;`). So while
// SNIPING or SCROLL is held, the `move` chain never runs -- without the processor in
// those chains too, AUTO_MOUSE would time out from under you mid-snipe.
// `move` needs no AUTO_MOUSE in its `layers`: BASE is always active, so it already
// matches as the catch-all.
#define CHARYBDIS_TRACKBALL_PROCESSORS \
    snipe { \
        layers = <SNIPING>; \
        input-processors = <&zip_temp_layer AUTO_MOUSE 500>, <&zip_xy_scaler 1 6>; \
    }; \
    \
    scroll { \
        layers = <SCROLL>; \
        input-processors = <&zip_temp_layer AUTO_MOUSE 500>, <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_scaler 1 160>, <&zip_xy_to_scroll_mapper>; \
    }; \
    \
    move { \
        layers = <BASE POINTER>; \
        input-processors = <&zip_temp_layer AUTO_MOUSE 500>, <&zip_xy_scaler 3 4>; \
    };

